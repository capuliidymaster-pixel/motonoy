  DateTime? lastESPUpdate;
  bool _firebaseConnected = false;

  // If no update arrives within this window, we mark the ESP32 as
  // "stale" (still has a last-known point, but flagged as not live).
  static const Duration _espStaleTimeout = Duration(seconds: 8);
  Timer? _espStaleCheckTimer;

  // ====================================================================
  // METRICS
  // ====================================================================

  double? distanceBetweenDevices; // in meters
  double? bearing; // in degrees

