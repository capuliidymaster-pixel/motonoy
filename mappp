                    espStatus == ConnectionStatus.error)
                  FloatingActionButton(
                    heroTag: "espReconnect",
                    backgroundColor: Colors.red,
                    foregroundColor: Colors.white,
                    mini: true,
                    onPressed: _manualReconnectESP32,
                    tooltip: "Reconnect to Firebase",
                    child: const Icon(Icons.refresh),
                  ),
              ],
            ),
          ),

          // ============================================================
          // BOTTOM DATA PANEL
          // ============================================================

          Positioned(
            bottom: 16,
            left: 16,
            right: 16,
            child: Align(
              alignment: Alignment.bottomLeft,
              child: Container(
                padding: const EdgeInsets.all(12),
                decoration: BoxDecoration(
                  color: const Color(0xFF161B22).withValues(alpha: 0.95),
                  borderRadius: BorderRadius.circular(10),
                  border: Border.all(color: Colors.white12, width: 1),
                ),
                child: Column(
                  mainAxisSize: MainAxisSize.min,
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    if (phoneGPSData != null) ...[
                      _buildDataField("Phone Alt",
                          "${phoneGPSData!.altitude?.toStringAsFixed(1) ?? 'N/A'} m"),
                      _buildDataField("Phone Acc",
                          "${phoneGPSData!.accuracy?.toStringAsFixed(1) ?? 'N/A'} m"),
                    ],
                    if (espGPSData != null) ...[
                      _buildDataField(
                          "MOTOR Sats", "${espGPSData!.satellites ?? 'N/A'}"),
                      _buildDataField("MOTOR Speed",
                          "${espGPSData!.speed?.toStringAsFixed(1) ?? 'N/A'} km/h"),
                      _buildDataField("MOTOR HDOP",
                          espGPSData!.accuracy?.toStringAsFixed(1) ?? 'N/A'),
                      if (espGPSData!.deviceTimestamp != null)
                        _buildDataField(
                          "MOTOR Last Fix",
                          _formatTime(espGPSData!.deviceTimestamp!),
                        ),
                    ],
                  ],
                ),
              ),
            ),
          ),
        ],
      ),
    );
  }

  // ====================================================================
  // BUILD STATUS ROW WIDGET
  // ====================================================================

  Widget _buildStatusRow({
    required IconData icon,
    required Color color,
    required String label,
    required String status,
    required ConnectionStatus connectionStatus,
    required GPSData? gpsData,
    required DateTime? lastUpdate,
  }) {
    final statusColor = _getStatusColor(connectionStatus);

    return Row(
      children: [
        // Connection indicator dot
        Container(
          width: 12,
          height: 12,
          decoration: BoxDecoration(
            shape: BoxShape.circle,
            color: statusColor,
            boxShadow: [
              BoxShadow(
                color: statusColor.withValues(alpha: 0.5),
                blurRadius: 6,
              ),
            ],
          ),
        ),
        const SizedBox(width: 8),

        // Icon
        Icon(icon, color: color, size: 18),
        const SizedBox(width: 6),

        // Status text
        Expanded(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Row(
                children: [
                  Text(
                    label,
                    style: TextStyle(
                      color: color,
                      fontSize: 12,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                  const SizedBox(width: 6),
                  Expanded(
                    child: Text(
                      status,
                      style: const TextStyle(
                        color: Colors.white,
                        fontSize: 12,
                      ),
                      overflow: TextOverflow.ellipsis,
                    ),
                  ),
                ],
              ),
              if (gpsData != null && lastUpdate != null)
                Text(
                  "Lat: ${gpsData.latitude.toStringAsFixed(5)}, Lon: ${gpsData.longitude.toStringAsFixed(5)}",
                  style: const TextStyle(
                    color: Colors.white70,
                    fontSize: 10,
                  ),
                  overflow: TextOverflow.ellipsis,
                ),
            ],
          ),
        ),

        // Last update indicator
        if (lastUpdate != null)
          Text(
            _formatTime(lastUpdate),
            style: const TextStyle(
              color: Colors.white54,
              fontSize: 9,
            ),
          ),
      ],
    );
  }

  // ====================================================================
  // BUILD DATA FIELD WIDGET
  // ====================================================================

  Widget _buildDataField(String label, String value) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 2),
      child: Row(
        mainAxisSize: MainAxisSize.min,
        children: [
          Text(
            "$label: ",
            style: const TextStyle(
              color: Colors.white70,
              fontSize: 11,
            ),
          ),
          Text(
            value,
            style: const TextStyle(
              color: Colors.cyan,
              fontSize: 11,
              fontWeight: FontWeight.bold,
            ),
          ),
        ],
      ),
    );
  }

  // ====================================================================
  // FORMAT TIME
  // ====================================================================

  String _formatTime(DateTime dateTime) {
    final now = DateTime.now();
    final diff = now.difference(dateTime);

    if (diff.inSeconds < 60) {
      return "${diff.inSeconds}s ago";
    } else if (diff.inMinutes < 60) {
      return "${diff.inMinutes}m ago";
    } else {
      return "${diff.inHours}h ago";
    }
  }
}
