    // so the UI can show "signal lost" instead of a frozen "connected".
    _espStaleCheckTimer =
        Timer.periodic(const Duration(seconds: 2), (_) => _checkESPStale());
  }

  // ====================================================================
  // DISPOSE
  // ====================================================================

