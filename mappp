// ======================================================================
// GPS DATA MODEL
// ======================================================================

class GPSData {
  final double latitude;
  final double longitude;
  final double? altitude;
  final double? speed;
  final double? accuracy;
  final int? satellites;
  final DateTime timestamp;
  final DateTime?
      deviceTimestamp; // actual time reported by the device (updatedAt)

  GPSData({
    required this.latitude,
    required this.longitude,
    this.altitude,
    this.speed,
    this.accuracy,
    this.satellites,
    required this.timestamp,
    this.deviceTimestamp,
  });

  bool isValid() {
    return latitude >= -90 &&
        latitude <= 90 &&
        longitude >= -180 &&
        longitude <= 180;
  }
}

// ======================================================================
// CONNECTION STATUS ENUM
// ======================================================================

enum ConnectionStatus {
  disconnected,
  searching,
  connecting,
  connected,
  error,
  reconnecting,
}

