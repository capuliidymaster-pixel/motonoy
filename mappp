  // ====================================================================
  // PHONE GPS
  // ====================================================================

  Future<void> _startPhoneGPS() async {
    try {
      if (!mounted) return;
      setState(() {
        phoneStatus = ConnectionStatus.searching;
        phoneStatusMessage = "Checking location services...";
      });

      // Check if location services are enabled
      bool serviceEnabled = await Geolocator.isLocationServiceEnabled();
      if (!serviceEnabled) {
        if (!mounted) return;
        setState(() {
          phoneStatus = ConnectionStatus.error;
          phoneStatusMessage = "Location services disabled";
        });
        return;
      }

      // Check location permission
      LocationPermission permission = await Geolocator.checkPermission();
      if (permission == LocationPermission.denied) {
        permission = await Geolocator.requestPermission();
        if (permission == LocationPermission.denied) {
          if (!mounted) return;
          setState(() {
            phoneStatus = ConnectionStatus.error;
            phoneStatusMessage = "Location permission denied";
          });
          return;
        }
      }

      if (permission == LocationPermission.deniedForever) {
        if (!mounted) return;
        setState(() {
          phoneStatus = ConnectionStatus.error;
          phoneStatusMessage = "Location permission permanently denied";
        });
        return;
      }

      // Get initial position
      if (!mounted) return;
      setState(() {
        phoneStatus = ConnectionStatus.connecting;
        phoneStatusMessage = "Acquiring initial position...";
      });

      Position position = await Geolocator.getCurrentPosition(
        locationSettings: const LocationSettings(
          accuracy: LocationAccuracy.bestForNavigation,
        ),
      ).timeout(
        const Duration(seconds: 30),
        onTimeout: () => throw Exception("Position timeout"),
      );

      if (!mounted) return;

      final now = DateTime.now();
      final gpsData = GPSData(
        latitude: position.latitude,
        longitude: position.longitude,
        altitude: position.altitude,
        speed: position.speed,
        accuracy: position.accuracy,
        timestamp: now,
      );

      setState(() {
        phoneLocation = LatLng(position.latitude, position.longitude);
        phoneGPSData = gpsData;
        lastPhoneUpdate = now;
        phoneStatus = ConnectionStatus.connected;
        phoneStatusMessage = "Phone GPS connected";
      });

      debugPrint(
        "✓ Phone GPS Initial: Lat=${position.latitude}, Lon=${position.longitude}",
      );

      // Start continuous position stream
      const LocationSettings settings = LocationSettings(
        accuracy: LocationAccuracy.bestForNavigation,
        distanceFilter: 2,
      );

      _phoneSubscription = Geolocator.getPositionStream(
        locationSettings: settings,
      ).listen(
        (Position position) {
          if (!mounted) return;

          final now = DateTime.now();
          final gpsData = GPSData(
            latitude: position.latitude,
            longitude: position.longitude,
            altitude: position.altitude,
            speed: position.speed,
            accuracy: position.accuracy,
            timestamp: now,
          );

          setState(() {
            phoneLocation = LatLng(position.latitude, position.longitude);
            phoneGPSData = gpsData;
            lastPhoneUpdate = now;
            phoneStatus = ConnectionStatus.connected;
            phoneStatusMessage = "Phone GPS connected";
          });

          _calculateMetrics();

          debugPrint(
            "📍 Phone: Lat=${position.latitude}, Lon=${position.longitude}, Acc=${position.accuracy}m",
          );
        },
        onError: (error) {
          if (!mounted) return;
          setState(() {
            phoneStatus = ConnectionStatus.error;
            phoneStatusMessage = "Phone GPS error: $error";
          });
          debugPrint("❌ Phone GPS Error: $error");
        },
      );
    } catch (e) {
      if (!mounted) return;
      setState(() {
        phoneStatus = ConnectionStatus.error;
        phoneStatusMessage = "Phone GPS error: $e";
      });
      debugPrint("❌ Phone GPS Exception: $e");
    }
  }

  // ====================================================================
  // FIREBASE CONNECTION STATE (".info/connected")
  // ====================================================================
  //
  // This tells us whether the app itself has a live socket connection
  // to the Firebase Realtime Database server, regardless of whether the
  // ESP32 has written any data yet. Without this, "no data yet" and
  // "phone has no internet" look identical to the user.
  // ====================================================================

  void _listenFirebaseConnection() {
    _firebaseConnectionSubscription?.cancel();

    _firebaseConnectionSubscription = _connectedRef.onValue.listen(
      (DatabaseEvent event) {
        if (!mounted) return;

        final connected = event.snapshot.value as bool? ?? false;
        _firebaseConnected = connected;

        debugPrint(connected
            ? "✓ Firebase: connected to server"
            : "❌ Firebase: not connected to server");

        if (!connected) {
          setState(() {
            espStatus = ConnectionStatus.disconnected;
            espStatusMessage = "No internet / Firebase unreachable";
          });
        } else if (espLocation == null) {
          // Connected to Firebase but haven't received motorcycle
          // data yet (e.g. ESP32 is off or hasn't sent a fix).
          setState(() {
            espStatus = ConnectionStatus.searching;
            espStatusMessage = "Waiting for motorcycle GPS...";
          });
        }
      },
      onError: (error) {
        debugPrint("❌ Firebase connection listener error: $error");
      },
    );
  }

  // ====================================================================
  // ESP32 / NEO-6M GPS — FIREBASE REALTIME DATABASE LISTENER
  // ====================================================================
  //
  // This replaces the old USB-serial reading. The ESP32 firmware writes
  // to /motorcycle/latitude, /motorcycle/longitude, /motorcycle/satellites,
  // /motorcycle/speed, /motorcycle/accuracy, /motorcycle/updatedAt and
  // /motorcycle/gpsStatus every ~5 seconds once the NEO-6M has a fix.
  // We just subscribe to that node and update the UI live.
  // ====================================================================

  void _startESP32GPS() {
    if (!mounted) return;

    setState(() {
      espStatus = ConnectionStatus.searching;
      espStatusMessage = "Connecting to Firebase...";
    });

    _espSubscription?.cancel();

    _espSubscription = _motorcycleRef.onValue.listen(
      (DatabaseEvent event) {
        if (!mounted) return;

        final raw = event.snapshot.value;

        if (raw == null) {
          setState(() {
            espStatus = ConnectionStatus.disconnected;
            espStatusMessage = "No motorcycle data yet";
          });
          return;
        }

        try {
          final data = Map<String, dynamic>.from(raw as Map);

          final latitude = _asDouble(data["latitude"]);
          final longitude = _asDouble(data["longitude"]);

          if (latitude == null || longitude == null) {
            setState(() {
              espStatus = ConnectionStatus.error;
              espStatusMessage = "Incomplete GPS data from device";
            });
            return;
          }

          // Validate coordinates
          if (latitude < -90 ||
              latitude > 90 ||
              longitude < -180 ||
              longitude > 180) {
            debugPrint("❌ Invalid coordinates: $latitude, $longitude");
            setState(() {
              espStatus = ConnectionStatus.error;
              espStatusMessage = "Invalid coordinates received";
            });
            return;
          }

          final satellites = _asInt(data["satellites"]);
          final speed = _asDouble(data["speed"]);
          final accuracy = _asDouble(data["accuracy"]);
          final gpsStatusText = data["gpsStatus"]?.toString();

          // Device-reported timestamp (Unix ms), if present, tells us
          // how fresh the GPS fix actually is at the source.
          final updatedAtMs = _asInt(data["updatedAt"]);
          final deviceTimestamp = (updatedAtMs != null && updatedAtMs > 0)
              ? DateTime.fromMillisecondsSinceEpoch(updatedAtMs)
              : null;

          final now = DateTime.now();
          final gpsData = GPSData(
            latitude: latitude,
            longitude: longitude,
            satellites: satellites,
            speed: speed,
            accuracy: accuracy,
            timestamp: now,
            deviceTimestamp: deviceTimestamp,
          );

          setState(() {
            espLocation = LatLng(latitude, longitude);
            espGPSData = gpsData;
            lastESPUpdate = now;
            espStatus = ConnectionStatus.connected;
            espStatusMessage = gpsStatusText != null
                ? "Motorcycle GPS: $gpsStatusText"
                : "Motorcycle GPS connected";
          });

          _calculateMetrics();

          debugPrint(
            "📍 ESP32/NEO-6M: Lat=$latitude, Lon=$longitude, Sats=$satellites, "
            "Speed=$speed, Acc=$accuracy",
          );
        } catch (e) {
          debugPrint("❌ Firebase GPS Parse Error: $e | raw: $raw");
          setState(() {
            espStatus = ConnectionStatus.error;
            espStatusMessage = "Error reading GPS data";
          });
        }
      },
      onError: (error) {
        if (!mounted) return;
        setState(() {
          espStatus = ConnectionStatus.error;
          espStatusMessage = "Firebase error: $error";
        });
        debugPrint("❌ Firebase Listener Error: $error");
      },
    );
  }

  // ====================================================================
  // STALE CHECK — flags the motorcycle marker if no fresh update
  // has arrived recently (e.g. ESP32 lost WiFi or GPS fix)
  // ====================================================================

  void _checkESPStale() {
    if (!mounted) return;
    if (lastESPUpdate == null) return;
    if (espStatus != ConnectionStatus.connected) return;

    final elapsed = DateTime.now().difference(lastESPUpdate!);
    if (elapsed > _espStaleTimeout) {
      setState(() {
        espStatus = ConnectionStatus.disconnected;
        espStatusMessage = "Signal lost - last known position shown";
      });
    }
  }

  // ====================================================================
  // SAFE NUMBER PARSING HELPERS (Firebase can return int or double)
  // ====================================================================

  double? _asDouble(dynamic value) {
    if (value == null) return null;
    if (value is double) return value;
    if (value is int) return value.toDouble();
    return double.tryParse(value.toString());
  }

  int? _asInt(dynamic value) {
    if (value == null) return null;
    if (value is int) return value;
    if (value is double) return value.toInt();
    return int.tryParse(value.toString());
  }

  // ====================================================================
  // CALCULATE METRICS
  // ====================================================================

  void _calculateMetrics() {
    if (phoneLocation != null && espLocation != null) {
      // Calculate distance using Haversine formula
      final distance = _calculateDistance(
        phoneLocation!.latitude,
        phoneLocation!.longitude,
        espLocation!.latitude,
        espLocation!.longitude,
      );

      // Calculate bearing
      final newBearing = _calculateBearing(
        phoneLocation!.latitude,
        phoneLocation!.longitude,
        espLocation!.latitude,
        espLocation!.longitude,
      );

      if (!mounted) return;
      setState(() {
        distanceBetweenDevices = distance;
        bearing = newBearing;
      });
    }
  }

  // Haversine distance formula (returns meters)
  double _calculateDistance(
      double lat1, double lon1, double lat2, double lon2) {
    const R = 6371000; // Earth radius in meters
    final dLat = _toRad(lat2 - lat1);
    final dLon = _toRad(lon2 - lon1);
    final a = math.sin(dLat / 2) * math.sin(dLat / 2) +
        math.cos(_toRad(lat1)) *
            math.cos(_toRad(lat2)) *
            math.sin(dLon / 2) *
            math.sin(dLon / 2);
    final c = 2 * math.atan2(math.sqrt(a), math.sqrt(1 - a));
    return R * c;
  }

  // Calculate bearing (returns degrees 0-360)
  double _calculateBearing(double lat1, double lon1, double lat2, double lon2) {
    final dLon = _toRad(lon2 - lon1);
    final y = math.sin(dLon) * math.cos(_toRad(lat2));
    final x = math.cos(_toRad(lat1)) * math.sin(_toRad(lat2)) -
        math.sin(_toRad(lat1)) * math.cos(_toRad(lat2)) * math.cos(dLon);
    final bearing = math.atan2(y, x);
    return (_toDeg(bearing) + 360) % 360;
  }

  double _toRad(double degree) => degree * math.pi / 180;
  double _toDeg(double radian) => radian * 180 / math.pi;

  // ====================================================================
  // GET CARDINAL DIRECTION
  // ====================================================================

  String _getCardinalDirection(double bearing) {
    const directions = [
      'N',
      'NNE',
      'NE',
      'ENE',
      'E',
      'ESE',
      'SE',
      'SSE',
      'S',
      'SSW',
      'SW',
      'WSW',
      'W',
      'WNW',
      'NW',
      'NNW'
    ];
    final index = ((bearing + 11.25) / 22.5).toInt() % 16;
    return directions[index];
  }

  // ====================================================================
  // GET STATUS COLOR
  // ====================================================================

  Color _getStatusColor(ConnectionStatus status) {
    switch (status) {
      case ConnectionStatus.connected:
        return Colors.green;
      case ConnectionStatus.connecting:
      case ConnectionStatus.searching:
        return Colors.amber;
      case ConnectionStatus.error:
      case ConnectionStatus.disconnected:
        return Colors.red;
      case ConnectionStatus.reconnecting:
        return Colors.orange;
    }
  }

