    return Scaffold(
      backgroundColor: kColorBackground,
      appBar: AppBar(
        backgroundColor: kColorSurface,
        elevation: 0,
        title: const Text(
          'MOTO GUARD',
          style: TextStyle(
            color: Colors.white,
            fontWeight: FontWeight.w700,
            fontSize: 18,
            letterSpacing: 0.5,
          ),
        ),
        leading: IconButton(
          icon: const Icon(Icons.arrow_back, color: Colors.white),
          onPressed: () => Navigator.pop(context),
        ),
        centerTitle: false,
      ),
      body: Stack(
        children: [
          // ============ MAP ============
          FlutterMap(
            mapController: _mapController,
            options: MapOptions(
              initialCenter: _initialCenter(),
              initialZoom: 16,
              onMapReady: () {
                _mapReady = true;
                final p = _initialCenter();
                _mapController.move(p, 16);
              },
              onPositionChanged: (camera, hasGesture) {
                if (hasGesture) _clearAllFollow();
              },
            ),
            children: [
              TileLayer(
                urlTemplate:
                    'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
                userAgentPackageName: 'com.example.motoguard',
              ),
              // ---- Polylines connecting phone to each motorcycle ----
              PolylineLayer(
                polylines: [
                  for (final m in _motos)
                    if (_phoneLocation != null && m.markerPos.value != null)
                      Polyline(
                        points: [_phoneLocation!, m.markerPos.value!],
                        color: m.config.colorOnline.withValues(alpha: 0.35),
                        strokeWidth: 3,
                      ),
                ],
              ),
              // ---- Markers layer ----
              AnimatedBuilder(
                animation: Listenable.merge(
                  _motos.map((m) => m.markerPos).toList(),
                ),
                builder: (context, _) {
                  final markers = <Marker>[];

                  if (kShowPhone && _phoneLocation != null) {
                    markers.add(
                      Marker(
                        point: _phoneLocation!,
                        width: 70,
                        height: 70,
                        child: _buildPhoneMarker(),
                      ),
                    );
                  }

                  for (final m in _motos) {
                    final pos = m.markerPos.value;
                    if (pos == null) continue;
                    final online = _evaluateHealth(m) == GpsHealth.online;
                    markers.add(
                      Marker(
                        point: pos,
                        width: 90,
                        height: 90,
                        child: _buildMotoMarker(
                          m,
                          online: online,
                          speed: m.data?.speedKmh,
                        ),
                      ),
                    );
                  }

                  return MarkerLayer(markers: markers);
                },
              ),
            ],
          ),

          // ============ TOP STATUS PANELS ============
          Positioned(
            top: 12,
            left: 12,
            right: 12,
            child: SingleChildScrollView(
              child: Column(
                mainAxisSize: MainAxisSize.min,
                children: [
                  for (int i = 0; i < _motos.length; i++) ...[
                    _buildMotoPanel(_motos[i]),
                    const SizedBox(height: 8),
                  ],
                  if (kShowPhone) _buildPhoneStatusBar(),
                ],
              ),
            ),
          ),

          // ============ CONTROL BUTTONS (Right side) ============
          Positioned(
            right: 16,
            bottom: kShowDebugLine ? 80 : 24,
            child: Column(
              mainAxisSize: MainAxisSize.min,
              children: [
                for (final m in _motos) ...[
                  _buildControlButton(
                    heroTag: m.config.id,
                    icon: Icons.two_wheeler,
                    label: m.config.label,
                    isActive: m.follow,
                    onPressed: () => _centerOnMoto(m),
                    color: m.config.colorOnline,
                  ),
                  const SizedBox(height: 12),
                ],
                if (kShowPhone)
                  _buildControlButton(
                    heroTag: 'phone',
                    icon: Icons.phone_android,
                    label: 'Phone',
                    isActive: _phoneFollow,
                    onPressed: _centerOnPhone,
                    color: kColorPhoneActive,
                  ),
              ],
            ),
          ),

          // ============ DEBUG INFO (Bottom) ============
          if (kShowDebugLine)
            Positioned(
              left: 12,
              right: 12,
              bottom: 12,
              child: Container(
                padding: const EdgeInsets.all(10),
                decoration: BoxDecoration(
                  color: Colors.black.withValues(alpha: 0.8),
                  borderRadius: BorderRadius.circular(8),
                  border: Border.all(color: Colors.white10, width: 1),
                ),
                child: Text(
                  _buildDebugString(),
                  style: const TextStyle(
                    color: Colors.white60,
                    fontSize: 9,
                    fontFamily: 'Courier',
                  ),
                ),
              ),
            ),
        ],
      ),
    );
  }

  LatLng _initialCenter() {
    for (final m in _motos) {
      final p = m.markerPos.value;
      if (p != null) return p;
    }
    return kDefaultCenter;
  }

  // ====================================================================
  // BUILD HELPERS
  // ====================================================================

