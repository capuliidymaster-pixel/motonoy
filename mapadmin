// ======================================================================
// DATA MODELS
// ======================================================================

double? _asDouble(Object? v) {
  if (v is num) {
    final d = v.toDouble();
    return d.isFinite ? d : null;
  }
  if (v is String) {
    final d = double.tryParse(v.trim());
    return (d != null && d.isFinite) ? d : null;
  }
  return null;
}

int? _asInt(Object? v) {
  if (v is int) return v;
  if (v is num) return v.toInt();
  if (v is String) return int.tryParse(v.trim());
  return null;
}

bool _asBool(Object? v) {
  if (v is bool) return v;
  if (v is String) return v.trim().toLowerCase() == 'true';
  return false;
}

/// Motorcycle GPS data structure (from Firebase)
class MotoGpsData {
  final double? latitude;
  final double? longitude;
  final double? altitude;
  final double? speedKmh;
  final double? accuracy;
  final double? hdop;
  final int? satellites;
  final bool gpsFix;
  final String status;
  final int? deviceTimestamp; // GPS UTC, Unix ms
  final int? updatedAt; // Firebase server time, Unix ms
  final int? seq;

  const MotoGpsData({
    this.latitude,
    this.longitude,
    this.altitude,
    this.speedKmh,
    this.accuracy,
    this.hdop,
    this.satellites,
    required this.gpsFix,
    required this.status,
    this.deviceTimestamp,
    this.updatedAt,
    this.seq,
  });

  factory MotoGpsData.fromMap(Map<Object?, Object?> m) {
    return MotoGpsData(
      latitude: _asDouble(m['latitude']),
      longitude: _asDouble(m['longitude']),
      altitude: _asDouble(m['altitude']),
      speedKmh: _asDouble(m['speed']),
      accuracy: _asDouble(m['accuracy']),
      hdop: _asDouble(m['hdop']),
      satellites: _asInt(m['satellites']),
      gpsFix: _asBool(m['gpsFix']),
      status: (m['status'] ?? 'UNKNOWN').toString(),
      deviceTimestamp: _asInt(m['deviceTimestamp']),
      updatedAt: _asInt(m['updatedAt']),
      seq: _asInt(m['seq']),
    );
  }

  bool get hasValidCoordinates {
    final lat = latitude;
    final lng = longitude;
    if (lat == null || lng == null) return false;
    if (lat < -90 || lat > 90 || lng < -180 || lng > 180) return false;
    if (lat == 0 && lng == 0) return false;
    return true;
  }

  LatLng? get position =>
      hasValidCoordinates ? LatLng(latitude!, longitude!) : null;
}

/// Health status of a motorcycle GPS connection
enum GpsHealth {
  waiting,
  online,
  gpsLost,
  stale,
  deviceOffline,
  firebaseOffline,
  firebaseError,
}

// ======================================================================
// PER-MOTORCYCLE RUNTIME STATE
// ======================================================================

class MotoTrack {
  final MotoConfig config;
  late final DatabaseReference ref;
  StreamSubscription<DatabaseEvent>? sub;

  MotoGpsData? data;
  int? lastSeq;
  int? lastUpdatedAt;
  int lastChangeMs = 0;
  String? error;

  final ValueNotifier<LatLng?> markerPos = ValueNotifier<LatLng?>(null);
  LatLng? animFrom;
  LatLng? animTo;
  late final AnimationController animController;
  bool follow = false;

  MotoTrack(this.config);

  void disposeTrack() {
    sub?.cancel();
    animController.dispose();
    markerPos.dispose();
  }
}

// ======================================================================
// MAIN MAP WIDGET
// ======================================================================

class TrackPage extends StatefulWidget {
  const TrackPage({super.key});

  @override
  State<TrackPage> createState() => _TrackPageState();
}

class _TrackPageState extends State<TrackPage> with TickerProviderStateMixin {
  // ---- Firebase (shared) ----
  late final FirebaseDatabase _db;
  StreamSubscription<DatabaseEvent>? _connSub;
  StreamSubscription<DatabaseEvent>? _offsetSub;

  bool _fbConnected = false;
  int _serverOffsetMs = 0;
  String? _dbError;

  final Stopwatch _clock = Stopwatch()..start();

  // ---- One tracker per motorcycle ----
  late final List<MotoTrack> _motos;

  // ---- Phone GPS ----
  StreamSubscription<Position>? _phoneSub;
  LatLng? _phoneLocation;
  String _phoneStatus = 'Initializing...';
  bool _phoneFollow = false;

  // ---- Map ----
  final MapController _mapController = MapController();
  bool _mapReady = false;

  Timer? _ticker;

  // ====================================================================
  // LIFECYCLE
  // ====================================================================

  @override
  void initState() {
    super.initState();

    _motos = kMotoConfigs.map((c) => MotoTrack(c)).toList();
    for (final m in _motos) {
      m.animController = AnimationController(
        vsync: this,
        duration: const Duration(milliseconds: 900),
      )..addListener(() => _onAnimTick(m));
    }

    _initializeFirebase();
    _startPhoneGps();
  }

  void _initializeFirebase() {
    _db = FirebaseDatabase.instanceFor(
      app: Firebase.app(),
      databaseURL: kDatabaseUrl,
    );

    // Firebase connectivity
    _connSub = _db.ref('.info/connected').onValue.listen((event) {
      if (!mounted) return;
      setState(() => _fbConnected = event.snapshot.value == true);
    }, onError: (Object e) {
      if (!mounted) return;
      setState(() => _dbError = e.toString());
    });

    // Server time offset for accurate age calculations
    _offsetSub = _db.ref('.info/serverTimeOffset').onValue.listen((event) {
      final v = event.snapshot.value;
      if (v is num) _serverOffsetMs = v.toInt();
    }, onError: (Object _) {});

    // One listener per motorcycle
    for (final m in _motos) {
      m.ref = _db.ref('gps/${m.config.id}');
      m.sub = m.ref.onValue.listen(
        (event) => _onGpsEvent(m, event),
        onError: (Object e) {
          if (!mounted) return;
          setState(() => m.error = e.toString());
        },
      );
    }

    // Re-evaluate health every second, even without new data.
    _ticker = Timer.periodic(const Duration(seconds: 1), (_) {
      if (mounted) setState(() {});
    });
  }

  @override
  void dispose() {
    for (final m in _motos) {
      m.disposeTrack();
    }
    _connSub?.cancel();
    _offsetSub?.cancel();
    _phoneSub?.cancel();
    _ticker?.cancel();
    _mapController.dispose();
    super.dispose();
  }

  // ====================================================================
  // PHONE GPS
  // ====================================================================

  Future<void> _startPhoneGps() async {
    if (!kShowPhone) return;

    try {
      final enabled = await Geolocator.isLocationServiceEnabled();
      if (!enabled) {
        _setPhoneStatus('Phone location services disabled');
        return;
      }

      var permission = await Geolocator.checkPermission();
      if (permission == LocationPermission.denied) {
        permission = await Geolocator.requestPermission();
      }

      if (permission == LocationPermission.denied ||
          permission == LocationPermission.deniedForever) {
        _setPhoneStatus('Location permission denied');
        return;
      }

      const settings = LocationSettings(
        accuracy: LocationAccuracy.high,
        distanceFilter: 2,
      );

      _phoneSub = Geolocator.getPositionStream(locationSettings: settings)
          .listen(
        (pos) {
          if (!mounted) return;
          setState(() {
            _phoneLocation = LatLng(pos.latitude, pos.longitude);
            _phoneStatus =
                'Location acquired (±${pos.accuracy.toStringAsFixed(0)} m)';
          });
          if (_phoneFollow && _mapReady) {
            _mapController.move(_phoneLocation!, _mapController.camera.zoom);
          }
        },
        onError: (Object e) {
          _setPhoneStatus('GPS error: $e');
        },
      );
    } catch (e) {
      _setPhoneStatus('GPS error: $e');
    }
  }

  void _setPhoneStatus(String s) {
    if (!mounted) return;
    setState(() => _phoneStatus = s);
  }

  // ====================================================================
  // MOTORCYCLE GPS (Firebase)
  // ====================================================================

  void _onGpsEvent(MotoTrack m, DatabaseEvent event) {
    if (!mounted) return;

    final value = event.snapshot.value;
    if (value is! Map) {
      setState(() {
        m.data = null;
        m.error = null;
      });
      return;
    }

    final MotoGpsData data;
    try {
      data = MotoGpsData.fromMap(Map<Object?, Object?>.from(value));
    } catch (e) {
      setState(() => m.error = 'Invalid Firebase data: $e');
      return;
    }

    // Track if NEW data arrived (by seq or server timestamp change)
    if (m.data == null ||
        data.seq != m.lastSeq ||
        data.updatedAt != m.lastUpdatedAt) {
      m.lastSeq = data.seq;
      m.lastUpdatedAt = data.updatedAt;
      m.lastChangeMs = _clock.elapsedMilliseconds;
    }

    setState(() {
      m.data = data;
      m.error = null;
    });

    // Only move the marker if the fix is LIVE and validated.
    if (_evaluateHealth(m) == GpsHealth.online) {
      final p = data.position;
      if (p != null) _moveMarkerTo(m, p);
    }
  }

  // ====================================================================
  // GPS HEALTH EVALUATION
  // ====================================================================

  int _serverNowMs() =>
      DateTime.now().millisecondsSinceEpoch + _serverOffsetMs;

  int? _serverAgeMs(MotoTrack m) {
    final u = m.data?.updatedAt;
    if (u == null) return null;
    return _serverNowMs() - u;
  }

  GpsHealth _evaluateHealth(MotoTrack m) {
    if (_dbError != null || m.error != null) return GpsHealth.firebaseError;
    if (!_fbConnected) return GpsHealth.firebaseOffline;

    final data = m.data;
    if (data == null) return GpsHealth.waiting;

    // Is the ESP32 alive? (server-time heartbeat + local "silence" timer)
    final silenceMs = _clock.elapsedMilliseconds - m.lastChangeMs;
    final serverAge = _serverAgeMs(m);
    if (serverAge == null ||
        serverAge > kHeartbeatTimeoutMs ||
        silenceMs > kHeartbeatTimeoutMs) {
      return GpsHealth.deviceOffline;
    }

    // Did the device report a validated fix?
    if (!data.gpsFix || data.status != 'GPS_ONLINE') {
      return GpsHealth.gpsLost;
    }

    // Cross-check data integrity.
    final sats = data.satellites ?? 0;
    final devTs = data.deviceTimestamp;
    final upAt = data.updatedAt;
    final tsDiff =
        (devTs == null || upAt == null) ? null : (upAt - devTs).abs();

    if (!data.hasValidCoordinates ||
        sats < kMinSatellites ||
        tsDiff == null ||
        tsDiff > kDeviceClockToleranceMs) {
      return GpsHealth.stale;
    }

    return GpsHealth.online;
  }

  // ====================================================================
  // MARKER ANIMATION
  // ====================================================================

  void _moveMarkerTo(MotoTrack m, LatLng target) {
    final current = m.markerPos.value;

    if (current == null) {
      m.markerPos.value = target;
      if (_mapReady && m.follow) {
        _mapController.move(target, 16);
      }
      return;
    }

    if (current.latitude == target.latitude &&
        current.longitude == target.longitude) {
      return;
    }

    // Far jump (>500 m): snap instead of gliding.
    final meters = const Distance().as(LengthUnit.Meter, current, target);
    if (meters > 500) {
      m.animController.stop();
      m.markerPos.value = target;
      if (_mapReady && m.follow) {
        _mapController.move(target, _mapController.camera.zoom);
      }
      return;
    }

    m.animFrom = current;
    m.animTo = target;
    m.animController.forward(from: 0);
  }

  void _onAnimTick(MotoTrack m) {
    final from = m.animFrom;
    final to = m.animTo;
    if (from == null || to == null) return;

    final t = m.animController.value;
    final p = LatLng(
      from.latitude + (to.latitude - from.latitude) * t,
      from.longitude + (to.longitude - from.longitude) * t,
    );

    m.markerPos.value = p;

    if (m.follow && _mapReady) {
      _mapController.move(p, _mapController.camera.zoom);
    }
  }

  // ====================================================================
  // FOLLOW CONTROLS
  // ====================================================================

  void _centerOnMoto(MotoTrack m) {
    final p = m.markerPos.value;
    if (p != null && _mapReady) {
      setState(() {
        for (final other in _motos) {
          other.follow = false;
        }
        m.follow = true;
        _phoneFollow = false;
      });
      _mapController.move(p, 17);
    }
  }

  void _centerOnPhone() {
    final phone = _phoneLocation;
    if (phone != null && _mapReady) {
      setState(() {
        for (final m in _motos) {
          m.follow = false;
        }
        _phoneFollow = true;
      });
      _mapController.move(phone, 17);
    }
  }

  void _clearAllFollow() {
    setState(() {
      for (final m in _motos) {
        m.follow = false;
      }
      _phoneFollow = false;
    });
  }

  // ====================================================================
  // FORMATTING & DISPLAY LOGIC
  // ====================================================================

  String _formatTime(int? ms) {
    if (ms == null) return '--:--:--';
    final d = DateTime.fromMillisecondsSinceEpoch(ms).toLocal();
    String two(int n) => n.toString().padLeft(2, '0');
    return '${two(d.hour)}:${two(d.minute)}:${two(d.second)}';
  }

  String _formatDistance(MotoTrack m) {
    if (_evaluateHealth(m) != GpsHealth.online) return '--';

    final phone = _phoneLocation;
    final moto = m.markerPos.value;
    if (phone == null || moto == null) return '--';

    final meters = const Distance().as(LengthUnit.Meter, phone, moto);
    return meters < 1000
        ? '${meters.toStringAsFixed(0)} m'
        : '${(meters / 1000).toStringAsFixed(2)} km';
  }

  Color _healthColor(GpsHealth health) {
    switch (health) {
      case GpsHealth.online:
        return kColorGpsOnline;
      case GpsHealth.gpsLost:
      case GpsHealth.stale:
        return kColorGpsWarning;
      case GpsHealth.deviceOffline:
      case GpsHealth.firebaseOffline:
      case GpsHealth.firebaseError:
        return kColorGpsError;
      case GpsHealth.waiting:
        return kColorBorder;
    }
  }

  String _healthLabel(GpsHealth health) {
    switch (health) {
      case GpsHealth.online:
        return 'ONLINE';
      case GpsHealth.gpsLost:
        return 'SIGNAL LOST';
      case GpsHealth.stale:
        return 'STALE';
      case GpsHealth.deviceOffline:
        return 'DEVICE OFFLINE';
      case GpsHealth.firebaseOffline:
        return 'FIREBASE OFFLINE';
      case GpsHealth.firebaseError:
        return 'DATABASE ERROR';
      case GpsHealth.waiting:
        return 'WAITING...';
    }
  }

  String _healthMessage(MotoTrack m, GpsHealth health) {
    switch (health) {
      case GpsHealth.online:
        return '';
      case GpsHealth.gpsLost:
        return '${m.config.label} GPS signal not acquired';
      case GpsHealth.stale:
        return '${m.config.label} data integrity check failed';
      case GpsHealth.deviceOffline:
        return '${m.config.label} ESP32/WiFi not responding';
      case GpsHealth.firebaseOffline:
        return 'Firebase connection lost';
      case GpsHealth.firebaseError:
        return m.error ?? _dbError ?? 'Database error';
      case GpsHealth.waiting:
        return 'Waiting for ${m.config.label} data...';
    }
  }

