const String kDatabaseUrl =
    'https://seretei8-default-rtdb.asia-southeast1.firebasedatabase.app';

/// Minimum satellites for the app to accept a fix as live.
const int kMinSatellites = 4;

/// If no NEW upload arrives from an ESP32 for this long -> DEVICE OFFLINE.
const int kHeartbeatTimeoutMs = 8000;

/// Max allowed difference between Firebase server time and GPS UTC time.
const int kDeviceClockToleranceMs = 10000;

/// Show the phone's own location.
const bool kShowPhone = true;

/// Show debug diagnostics at the bottom.
const bool kShowDebugLine = true;

/// Default map center if no GPS data exists yet.
const LatLng kDefaultCenter = LatLng(14.5995, 120.9842);

// ======================================================================
// COLOR PALETTE
// ======================================================================

const Color kColorBackground = Color(0xFF0D1117);
const Color kColorSurface = Color(0xFF161B22);
const Color kColorBorder = Color(0xFF30363D);

const Color kColorPhoneActive = Color(0xFF58A6FF); // Blue
const Color kColorGpsOnline = Color(0xFF3FB950); // Green
const Color kColorGpsWarning = Color(0xFFD29922); // Orange warning
const Color kColorGpsError = Color(0xFFF85149); // Red

