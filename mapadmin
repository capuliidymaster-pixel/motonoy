    final health = _evaluateHealth(m);
    final color = _healthColor(health);
    final data = m.data;
    final online = health == GpsHealth.online;
    final message = _healthMessage(m, health);
    final distance = _formatDistance(m);

    return Container(
      decoration: BoxDecoration(
        color: kColorSurface.withValues(alpha: 0.98),
        borderRadius: BorderRadius.circular(12),
        border: Border.all(color: color, width: 2),
        boxShadow: [
          BoxShadow(
            color: color.withValues(alpha: 0.2),
            blurRadius: 12,
            offset: const Offset(0, 4),
          ),
        ],
      ),
      padding: const EdgeInsets.all(14),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        mainAxisSize: MainAxisSize.min,
        children: [
          // Header
          Row(
            children: [
              Container(
                width: 10,
                height: 10,
                decoration: BoxDecoration(
                  shape: BoxShape.circle,
                  color: m.config.colorOnline,
                ),
              ),
              const SizedBox(width: 8),
              Container(
                width: 12,
                height: 12,
                decoration: BoxDecoration(
                  shape: BoxShape.circle,
                  color: color,
                  boxShadow: [
                    BoxShadow(color: color.withValues(alpha: 0.6), blurRadius: 6),
                  ],
                ),
              ),
              const SizedBox(width: 10),
              Expanded(
                child: Text(
                  '${m.config.label}: ${_healthLabel(health)}',
                  style: TextStyle(
                    color: color,
                    fontSize: 14,
                    fontWeight: FontWeight.w700,
                    letterSpacing: 0.3,
                  ),
                ),
              ),
            ],
          ),

          if (message.isNotEmpty) ...[
            const SizedBox(height: 8),
            Text(
              message,
              style: const TextStyle(color: Colors.white70, fontSize: 12),
            ),
          ],

          const SizedBox(height: 10),

          if (data != null && online) ...[
            _buildDataRow('Satellites', '${data.satellites ?? 0}'),
            _buildDataRow(
              'Accuracy',
              data.accuracy != null
                  ? '${data.accuracy!.toStringAsFixed(1)} m'
                  : '--',
            ),
            _buildDataRow(
              'Speed',
              data.speedKmh != null
                  ? '${data.speedKmh!.toStringAsFixed(1)} km/h'
                  : '--',
            ),
            _buildDataRow('Last Update', _formatTime(data.updatedAt)),
          ] else if (data != null) ...[
            _buildDataRow('Satellites', '${data.satellites ?? 0}'),
            _buildDataRow('Last Fix', _formatTime(data.deviceTimestamp)),
            _buildDataRow('Last Update', _formatTime(data.updatedAt)),
          ],

          if (kShowPhone && _phoneLocation != null) ...[
            const SizedBox(height: 6),
            Container(
              padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 8),
              decoration: BoxDecoration(
                color: Colors.black26,
                borderRadius: BorderRadius.circular(6),
              ),
              child: Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  const Text(
                    'Distance from phone',
                    style: TextStyle(color: Colors.white60, fontSize: 12),
                  ),
                  Text(
                    distance,
                    style: TextStyle(
                      color: m.config.colorOnline,
                      fontSize: 14,
                      fontWeight: FontWeight.w700,
                    ),
                  ),
                ],
              ),
            ),
          ],
        ],
      ),
    );
  }

