static const uint32_t MAX_FIELD_AGE_MS = 3000;
static const uint32_t NMEA_TIMEOUT_MS  = 3000;

// Diagnostics
static const uint32_t FROZEN_WARN_SECONDS = 30;
static const double   JUMP_WARN_METERS    = 50.0;
static const double   SPEED_DEADBAND_KMH  = 1.0;
static const double   ACCURACY_PER_HDOP_M = 2.5;   // estimated accuracy = HDOP * 2.5 m

// Network
